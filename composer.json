{
	"name": "tacoberu/hayo",
	"type": "library",
	"description": "Lightweight purely functional scripting runtime with static typing and type inference.",
	"license": [
		"MIT"
	],
	"authors": [
		{
			"name": "Martin Takáč",
			"homepage": "http://martin.takac.name"
		}
	],
	"require": {
		"tacoberu/hayo-decoder": "~0.3.9"
	},
	"require-dev": {
		"tracy/tracy": "^2.7",
		"phpunit/phpunit": "^11.5",
		"slevomat/coding-standard": "^8.24",
		"phpstan/phpstan": "^2.1",
		"spaze/phpstan-disallowed-calls": "^4.6",
		"rector/rector": "^2.2"
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "git@gitlab.com:tacoberu/php-hayo-ast.git"
		},
		{
			"type": "vcs",
			"url": "git@gitlab.com:tacoberu/php-hayo-decoder.git"
		}
	],
	"autoload": {
		"classmap": [
			"libs/"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"phpunit": [
			"vendor/bin/phpunit"
		],
		"phpcs": [
			"vendor/bin/phpcs"
		],
		"phpcbf": [
			"vendor/bin/phpcbf"
		],
		"phpstan": [
			"vendor/bin/phpstan analyse --memory-limit=512M"
		],
		"rector": [
			"vendor/bin/rector process --dry-run"
		]
	}
}
